<ui:FluentWindow x:Class="PrivacyGuard.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:PrivacyGuard.App.Pages"
                 Title="PrivacyGuard · Omega Msiska"
                 Icon="pack://application:,,,/PrivacyGuard.App;component/Assets/privacyguard.ico"
                 Width="1100" Height="740" MinWidth="860" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="PrivacyGuard · Omega Msiska">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PrivacyGuard.App;component/Assets/logo.png"
                              Width="18" Height="18" AutomationProperties.Name="PrivacyGuard logo" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="230"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           TitleBar="{Binding ElementName=TitleBar}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Live protection"
                                       TargetPageType="{x:Type pages:LivePage}"
                                       Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                <ui:NavigationViewItem Content="Rules"
                                       TargetPageType="{x:Type pages:RulesPage}"
                                       Icon="{ui:SymbolIcon Shield24}" />
                <ui:NavigationViewItem Content="Test lab"
                                       TargetPageType="{x:Type pages:TestLabPage}"
                                       Icon="{ui:SymbolIcon Beaker24}" />
                <ui:NavigationViewItem Content="Found on this PC"
                                       TargetPageType="{x:Type pages:AutoDetectedPage}"
                                       Icon="{ui:SymbolIcon Sparkle24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="About"
                                       TargetPageType="{x:Type pages:AboutPage}"
                                       Icon="{ui:SymbolIcon Info24}" />
                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type pages:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
