    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\privacyguard.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PrivacyGuard</Product>
    <Version>1.0.0</Version>
    <Authors>Omega Msiska</Authors>
    <Copyright>© 2026 Omega Msiska. Licensed under the Apache License 2.0.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\privacyguard.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>

