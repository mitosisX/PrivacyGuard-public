<ui:FluentWindow x:Class="PrivacyGuard.App.Views.RuleEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:h="clr-namespace:PrivacyGuard.App.Helpers"
                 Title="{Binding WindowTitle}"
                 Width="700" Height="820" MinWidth="560" MinHeight="620"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/PrivacyGuard.App;component/Assets/logo.png"
                              Width="16" Height="16" AutomationProperties.Name="PrivacyGuard logo" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,16">

                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="Name (optional)" />
                <ui:TextBox PlaceholderText="For example: Home Wi-Fi"
                            Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="What to hide" />
                <ComboBox ItemsSource="{x:Static h:EditorChoices.Kinds}"
                          DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding Kind}" HorizontalAlignment="Stretch" />

                <StackPanel Visibility="{Binding ShowPattern, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern" />
                    <ui:TextBox PlaceholderText="Type the text or pattern"
                                FontFamily="Consolas"
                                Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding PatternHint}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detector" />
                    <ComboBox ItemsSource="{x:Static h:EditorChoices.BuiltIns}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding BuiltIn}" HorizontalAlignment="Stretch" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding BuiltInDescription}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowTextOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Options" />
                    <CheckBox Content="Match upper and lower case exactly" IsChecked="{Binding CaseSensitive}" />
                    <CheckBox Content="Whole word only" IsChecked="{Binding WholeWord}" />
                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Fuzzy match (tolerates OCR mistakes like 0 for O)" IsChecked="{Binding Fuzzy}" />
                        <StackPanel Visibility="{Binding ShowThreshold, Converter={StaticResource BoolToVis}}"
                                    Margin="28,4,0,0">
                            <TextBlock>
                                <Run Text="Similarity needed:" />
                                <Run Text="{Binding FuzzyThreshold}" FontWeight="SemiBold" /><Run Text="%" FontWeight="SemiBold" />
                            </TextBlock>
                            <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding FuzzyThreshold}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Lower catches more OCR mistakes but may hide similar words by accident. 85 is a good start." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowTryIt, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,24,0,6" Text="Try it" />
                    <ui:TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalScrollBarVisibility="Auto"
                                Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Type or paste sample text above. Matches are highlighted below as you type." />

                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6" MinHeight="96"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <RichTextBox x:Name="PreviewBox" IsReadOnly="True" Background="Transparent"
                                     BorderThickness="0" Padding="0" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,24,0,6" Text="Open windows"
                           Visibility="{Binding IsAppWindow, Converter={StaticResource BoolToVis}}" />

                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Text="{Binding Error}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,14"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="96" />
                <ui:Button Content="Save rule" Appearance="Primary" IsDefault="True" Margin="10,0,0,0"
                           MinWidth="110" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
