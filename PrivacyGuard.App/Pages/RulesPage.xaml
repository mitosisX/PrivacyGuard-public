<Page x:Class="PrivacyGuard.App.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Rules"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="32,16,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Rules" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,16">
            <ui:Button Content="Add rule" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="AddRule_Click">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Text (a name, network, address...)" Tag="Text" Click="AddKind_Click" />
                        <MenuItem Header="Regular expression" Tag="Regex" Click="AddKind_Click" />
                        <MenuItem Header="Built-in detector (wallets, email, IP, phone...)" Tag="BuiltIn" Click="AddKind_Click" />
                        <MenuItem Header="App or window (MetaMask, Exodus...)" Tag="AppWindow" Click="AddKind_Click" />
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>
            <ui:Button Content="Add recommended detectors" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon ShieldCheckmark24}" Click="AddRecommended_Click" />
            <ui:Button x:Name="HideButton" Content="Hide values" Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon EyeOff24}" Click="ToggleHide_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:ToggleSwitch Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                                     IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                     ToolTip="Turn this rule on or off"
                                                     AutomationProperties.Name="{Binding Title, StringFormat=Rule active: {0}}" />

                                    <!-- Dimmed when the rule is off, so its state is not shown by the switch alone. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" ToolTip="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <!-- Code font only for real patterns, not for descriptions. -->
                                                        <DataTrigger Binding="{Binding SubtitleIsPattern}" Value="True">
                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="2" Margin="12,0" Padding="8,3" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <ui:Button Grid.Column="3" Appearance="Transparent" ToolTip="Edit rule"
                                               MinWidth="36" MinHeight="36"
                                               AutomationProperties.Name="{Binding Title, StringFormat=Edit {0}}"
                                               Icon="{ui:SymbolIcon Edit24}" Tag="{Binding}" Click="Edit_Click" />
                                    <ui:Button Grid.Column="4" Appearance="Transparent" ToolTip="Delete rule"
                                               MinWidth="36" MinHeight="36" Margin="4,0,0,0"
                                               AutomationProperties.Name="{Binding Title, StringFormat=Delete {0}}"
                                               Icon="{ui:SymbolIcon Delete24}" Tag="{Binding}" Click="Delete_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,60,0,0" MaxWidth="460">
                    <ui:SymbolIcon Symbol="Shield24" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Nothing is protected yet" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Add words, patterns or built-in detectors. While live protection is on, anything that matches an enabled rule is covered on screen." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <ui:Button Content="Add recommended detectors" Appearance="Primary" Click="AddRecommended_Click" />
                        <ui:Button Content="Scan this PC" Margin="8,0,0,0" Click="ScanPc_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
