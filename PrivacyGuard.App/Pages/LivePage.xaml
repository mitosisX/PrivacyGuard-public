<Page x:Class="PrivacyGuard.App.Pages.LivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Live protection"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Live protection" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Covers anything that matches your rules, anywhere on screen, as you use your PC. Everything happens on this PC; nothing is uploaded." />

            <!-- Main switch -->
            <Border x:Name="StatusCard" Margin="0,20,0,0" Padding="20" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon x:Name="StatusIcon" Grid.Column="0" Symbol="Shield24" FontSize="36"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" Text="Protection is off" />
                        <TextBlock x:Name="StatusDetail" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="LiveSwitch" Grid.Column="2" VerticalAlignment="Center"
                                     AutomationProperties.Name="Live protection" ToolTip="Turn live protection on or off"
                                     Checked="LiveSwitch_Changed" Unchecked="LiveSwitch_Changed" />
                </Grid>
            </Border>

            <ui:InfoBar x:Name="ProblemBar" Margin="0,8,0,0" IsOpen="False" IsClosable="False" Severity="Error"
                        Title="Live protection has a problem" />
            <ui:InfoBar x:Name="NoRulesBar" Margin="0,8,0,0" IsOpen="False" IsClosable="False" Severity="Informational"
                        Title="Nothing to look for yet"
                        Message="Add rules on the Rules page (for example the recommended detectors), then come back." />

            <!-- Live numbers -->
            <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,12,0,0">
                <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="ItemsValue" Text="0" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="items hidden now" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="WindowsValue" Text="0" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="windows watched" ToolTip="Visible windows being checked right now" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="OcrValue" Text="-" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="average scan time" ToolTip="How long reading new text on screen takes, on average" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="14,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="MemoryValue" Text="-" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="memory used" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Options -->
            <TextBlock Text="Options" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Keep running when the window is closed" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="PrivacyGuard stays in the system tray and keeps protecting. Use Exit in the tray menu to stop it completely." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TraySwitch" Checked="TraySwitch_Changed" Unchecked="TraySwitch_Changed" />
            </ui:CardControl>

            <!-- Honest notes -->
            <TextBlock Text="Good to know" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="OBS and other recorders: " />
                        <Run Text="use Display Capture (the whole screen). Window Capture records an app on its own, without the boxes." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Wallet apps: " />
                        <Run Text="add an 'App or window' rule (for example MetaMask or Exodus). The whole window is covered the moment it opens, before any text is read." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Limits: " />
                        <Run Text="admin windows, the lock screen, full-screen exclusive games and taskbar panels (Quick Settings, Start, notifications) cannot be covered. If your Wi-Fi name must stay off stream, record a single window in OBS rather than the whole display. Text inside images and video is read too, but less reliably." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="PrivacyGuard's own window " />
                        <Run Text="is not covered, so you can edit your rules. Use Hide values on the Rules page when you are live." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
