<Page x:Class="PrivacyGuard.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:PrivacyGuard.App.Controls"
      Title="Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!--
          A round colour swatch (see ColorSwatch.cs for the motion). Background is the colour,
          Foreground the ink for the tick. The 52 px cell keeps a comfortable click target.
          No rings anywhere: selection, hover and focus are all shown with the glow.
        -->
        <Style x:Key="Swatch" TargetType="c:ColorSwatch">
            <Setter Property="GroupName" Value="BoxColor" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="c:ColorSwatch">
                        <Grid Width="52" Height="52" Background="Transparent">
                            <Grid x:Name="PART_Body">
                                <!-- The glow: a blurred copy of the disc that swells out and fades. -->
                                <Ellipse x:Name="PART_Glow" Width="38" Height="38" Opacity="0"
                                         IsHitTestVisible="False" Fill="{TemplateBinding Background}">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="10" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Grid x:Name="PART_Disc" Width="38" Height="38">
                                    <!-- No outline: a soft shadow keeps light and dark swatches distinct from the card. -->
                                    <Ellipse Fill="{TemplateBinding Background}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.35" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Path x:Name="PART_Check" Data="M 12.5,19.5 L 16.5,23.5 L 25.5,14.5"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />

            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Sparkle24}">
                <ui:CardControl.Header>
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" MinWidth="160" SelectionChanged="ThemeBox_SelectionChanged"
                          AutomationProperties.Name="Theme" />
            </ui:CardControl>

            <TextBlock Text="Redaction boxes" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <Border Padding="16" CornerRadius="8" BorderThickness="1" Margin="0,0,0,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Color24" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" FontSize="14">
                                <Run Text="Fill colour" />
                                <Run x:Name="CurrentText" FontWeight="Normal"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="The colour that covers matched text. Boxes are always solid, so nothing underneath can be recovered. Changes apply instantly." />
                        </StackPanel>
                    </Grid>

                    <WrapPanel x:Name="SwatchPanel" Margin="26,10,0,0" />

                    <!-- What a covered item will look like. -->
                    <Border Margin="36,10,0,0" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preview   Email: " FontFamily="Consolas" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="PreviewBox" Width="170" Height="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Popup x:Name="PickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade" HorizontalOffset="-12">
                <Border Margin="12" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        PreviewKeyDown="Picker_PreviewKeyDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
                    </Border.Effect>
                    <c:ColorPicker x:Name="Picker" />
                </Border>
            </Popup>

            <TextBlock Text="Your data" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon LockClosed24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Rules are encrypted for your Windows account" FontWeight="SemiBold" />
                        <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Open folder" Click="OpenFolder_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
