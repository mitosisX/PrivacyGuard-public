<Page x:Class="PrivacyGuard.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/PrivacyGuard.App;component/Assets/logo.png"
                       Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,20,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="PrivacyGuard logo" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PrivacyGuard" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Covers sensitive text on your screen in real time, such as wallet addresses, emails, API keys and network names, so you can stream, record and share your screen without leaking it." />
                </StackPanel>
            </Grid>

            <TextBlock Text="Developer" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,8" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Person24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Omega Msiska" FontWeight="SemiBold" />
                        <TextBlock Text="Developer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Code24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="GitHub" FontWeight="SemiBold" />
                        <TextBlock x:Name="GitHubText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Open profile" Icon="{ui:SymbolIcon Open24}" Click="GitHub_Click" />
            </ui:CardControl>

            <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Everything stays on this PC" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Your screen is read locally with Windows' built-in text recognition. No screen content, text or rules are ever uploaded, and the logs never contain what is on your screen." />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <TextBlock x:Name="CopyrightText" Margin="0,24,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
